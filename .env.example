# SantexGo — lokal infratuzilma sozlamalari (docker/docker-compose.yml).
# "pnpm setup:local" bu faylni tasodifiy parollar bilan avtomatik yaratadi.
# Qo'lda: cp .env.example .env  va parollarni o'zgartiring.
# Diqqat: baza birinchi marta yaratilgandan keyin POSTGRES_PASSWORD ni o'zgartirish ishlamaydi
# (eski parol bazada qoladi). Kerak bo'lsa: pnpm infra:reset — lokal ma'lumotlar o'chadi.

POSTGRES_DB=santexgo
POSTGRES_USER=santexgo
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

REDIS_PASSWORD=change_me_local_only
REDIS_PORT=6379

# Kamida 16 belgi
MEILI_MASTER_KEY=change_me_local_master_key
MEILI_PORT=7700

# S3 kalitlari docker/seaweedfs/s3.json faylida (faqat lokal muhit uchun)
S3_PORT=8333
