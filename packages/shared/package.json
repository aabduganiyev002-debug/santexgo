{
  "name": "@santexgo/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend va backend uchun umumiy konstantalar, tiplar va yordamchi funksiyalar",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
