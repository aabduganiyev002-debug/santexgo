# SantexGo — production sozlamalari (docker/docker-compose.prod.yml).
#
# Yaratish: sh scripts/prod.sh init   — bu faylni docker/.env.production ga nusxalaydi va
#           parollar/kalitlarni tasodifiy qiymatlar bilan to'ldiradi. Qolganini qo'lda tahrirlang.
# Diqqat: docker/.env.production maxfiy — git'ga qo'shilmaydi, faqat serverda saqlanadi.
# Qiymatda $ belgisi bo'lsa, uni bittalik qo'shtirnoqqa oling: ESKIZ_PASSWORD='pa$$word'

# ── Domenlar ──
# DNS'da ikkala domen (va www.SITE_DOMAIN) A yozuvi server IP manziliga qaratilgan bo'lishi kerak
SITE_DOMAIN=santexgo.uz
ADMIN_DOMAIN=admin.santexgo.uz
# Let's Encrypt sertifikat muddati haqidagi xabarlar uchun
ACME_EMAIL=admin@santexgo.uz

# ── Maxfiy kalitlar (init avtomatik yaratadi; faqat harf va raqam — URL'da muammo bo'lmasin) ──
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Tokenlar va SMS kodlarni imzolash kaliti. O'zgartirilsa — barcha foydalanuvchilar qayta kiradi
AUTH_SECRET=

POSTGRES_DB=santexgo
POSTGRES_USER=santexgo

# ── SMS (Eskiz.uz) — ro'yxatdan o'tish, parol tiklash ──
# SMS matnlari Eskiz kabinetida shablon sifatida tasdiqlangan bo'lishi kerak:
#   apps/api/src/modules/auth/sms-messages.ts va .../notifications/order-notifications.service.ts
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_SENDER=4546
# Bir kunda yuboriladigan SMS'lar chegarasi (SMS balansini himoya qilish uchun)
SMS_DAILY_LIMIT=2000
# Buyurtma holati haqida mijozga SMS (qabul qilindi, yo'lga chiqdi, yetkazildi, bekor qilindi)
ORDER_SMS_ENABLED=false

# ── Fayllar (mahsulot rasmlari, logotiplar, PDF) ──
# local — server diskida ("uploads" Docker hajmi, har kuni zaxiralanadi)
# s3    — Cloudflare R2 / AWS S3 / boshqa S3-mos xizmat
STORAGE_DRIVER=local
# Fayllarning ochiq manzili: local uchun /api/media; S3 uchun bucket yoki CDN manzili
MEDIA_PUBLIC_URL=/api/media
# Rasmlar boshqa domendan berilsa (S3/CDN), o'sha domen — sahifa xavfsizlik siyosatida ruxsat uchun.
# Masalan: https://media.santexgo.uz  (local uchun bo'sh qoldiring)
MEDIA_ORIGIN=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# ── Boshqa ──
APP_TIMEZONE=Asia/Tashkent
# Bitta API nusxasi uchun bazaga ulanishlar soni
DATABASE_POOL_SIZE=10
# Namunaviy mahsulot va chegirmalar (faqat sinov serveri uchun true)
SEED_SAMPLE_PRODUCTS=false

# ── Zaxira nusxalar (backup) ──
# Jadval cron formatida, UTC vaqtida: "0 22 * * *" — har kuni Toshkent vaqti bilan 03:00
BACKUP_CRON="0 22 * * *"
# Necha kunlik baza zaxiralari saqlanadi
BACKUP_KEEP_DAYS=14
# Zaxiralar papkasi (serverda). Nisbiy yo'l docker/ papkasiga nisbatan
BACKUP_DIR=./backups
