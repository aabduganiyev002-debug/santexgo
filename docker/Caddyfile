# SantexGo — Caddy: avtomatik HTTPS (Let's Encrypt), HTTP→HTTPS, siqish va so'rovlarni taqsimlash.
# Domenlar docker/.env.production dan olinadi: SITE_DOMAIN, ADMIN_DOMAIN, ACME_EMAIL.
#
#   https://SITE_DOMAIN/api/*   → API (4000)        https://SITE_DOMAIN/*   → sayt (3000)
#   https://ADMIN_DOMAIN/api/*  → API (4000)        https://ADMIN_DOMAIN/*  → admin panel (3001)
#   https://www.SITE_DOMAIN/*   → https://SITE_DOMAIN/* (301)
{
	email {$ACME_EMAIL}
	# *.localhost kabi ichki sertifikatlarda tizim ishonch ro'yxatiga yozishga urinmaslik
	skip_install_trust
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		# Ilova o'z CSP'sini bermagan javoblar uchun eng qat'iy standart (masalan, kutilmagan
		# HTML sahifa): unda hech qanday skript ishlamaydi
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		-Server
		-X-Powered-By
	}
	log {
		output stdout
		format json
	}
}

# @foreignOrigin matcher'i bilan: API xato formatidagi 403 javob (CSRF va CORS'ga qarshi birinchi qavat)
(reject-foreign-origin) {
	header @foreignOrigin Content-Type "application/json; charset=utf-8"
	respond @foreignOrigin `{"statusCode":403,"code":"CSRF_REJECTED","message":"So‘rov rad etildi: ruxsat etilmagan manba"}` 403
}

{$SITE_DOMAIN} {
	import common

	# Admin API faqat admin domeni orqali: saytdagi biror zaiflik admin cookie'lari bilan
	# boshqaruv so'rovlarini yubora olmaydi
	@adminApi path_regexp (?i)^/+api/+v[0-9]+/+admin(/|$)
	# API'ga boshqa saytdan (shu jumladan admin domenidan) kelgan brauzer so'rovlari rad etiladi.
	# Sayt va admin panel API'ga faqat o'z domeni orqali murojaat qiladi — CORS kerak emas
	@foreignOrigin {
		path /api/*
		header Origin *
		not header Origin https://{$SITE_DOMAIN}
	}

	route {
		respond @adminApi 404
		import reject-foreign-origin
		reverse_proxy /api/* api:4000
		reverse_proxy web:3000
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$ADMIN_DOMAIN} {
	import common

	# Admin API'ga faqat admin panelning o'zidan: sayt sahifalaridan kelgan so'rovlar ham rad etiladi
	@foreignOrigin {
		path /api/*
		header Origin *
		not header Origin https://{$ADMIN_DOMAIN}
	}

	route {
		import reject-foreign-origin
		reverse_proxy /api/* api:4000
		reverse_proxy admin:3001
	}
}
