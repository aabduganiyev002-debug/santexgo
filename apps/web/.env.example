# SantexGo — mijozlar sayti sozlamalari ("pnpm setup:local" avtomatik yaratadi)

# API manzili (sayt serveri undan ma'lumot oladi). Docker ichida: http://api:4000
API_INTERNAL_URL=http://127.0.0.1:4000

# Saytning ochiq manzili (SEO, ijtimoiy tarmoqlar uchun havolalar)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rasmlar boshqa domendan berilsa (S3/CDN, masalan https://media.santexgo.uz) — sahifa xavfsizlik
# siyosati (CSP) ularga ruxsat berishi uchun. Lokal ishlab chiqishda localhost avtomatik ruxsat etilgan
MEDIA_ORIGIN=
