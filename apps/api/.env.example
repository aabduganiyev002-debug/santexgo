# SantexGo API sozlamalari.
# "pnpm setup:local" bu faylni avtomatik yaratadi. Qo'lda: cp .env.example .env

NODE_ENV=development
# 127.0.0.1 — API faqat shu kompyuterdan ochiladi. Serverda (Docker ichida) 0.0.0.0
HOST=127.0.0.1
PORT=4000
APP_TIMEZONE=Asia/Tashkent

# Ildizdagi .env dagi POSTGRES_* qiymatlari bilan bir xil bo'lishi kerak
DATABASE_URL=postgresql://santexgo:change_me_local_only@127.0.0.1:5432/santexgo

# Frontend manzillari (vergul bilan): storefront va admin panel
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API hujjati: http://localhost:4000/api/docs (production'da false)
SWAGGER_ENABLED=true

# ── Xavfsizlik ──
# Tokenlar va SMS kodlarni imzolash kaliti (kamida 32 belgi). "pnpm setup:local" o'zi yaratadi.
# Production uchun yangi kalit: openssl rand -hex 32  (o'zgartirilsa, hamma qayta kiradi)
AUTH_SECRET=
# Kirish sessiyasi: access token (daqiqa) va "eslab qolish" muddati (kun)
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Redis (rate limit). Bo'sh bo'lsa — API xotirasida (faqat bitta API nusxasi uchun yetarli)
REDIS_URL=

# ── SMS ──
# console — SMS yuborilmaydi, kod "pnpm dev" terminaliga chiqadi (lokal sinov uchun)
# eskiz   — Eskiz.uz orqali haqiqiy SMS (production). SMS matnlari Eskiz kabinetida
#           shablon sifatida tasdiqlangan bo'lishi kerak: apps/api/src/modules/auth/sms-messages.ts
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
SMS_SENDER=4546
# Bir kunda yuboriladigan SMS'lar chegarasi (SMS balansini himoya qilish uchun)
SMS_DAILY_LIMIT=2000

# ── Seed: birinchi admin akkaunt (faqat pnpm db:seed uchun) ──
# Parol kamida 10 belgi. Bo'sh qoldirilsa, admin yaratilmaydi.
# Parolda # yoki probel bo'lsa, qo'shtirnoqqa oling: ADMIN_PASSWORD="Abc#12345678"
ADMIN_PHONE=+998901234567
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=SantexGo
