root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Windows buyruq fayllari: cmd.exe faqat CRLF bilan to'g'ri o'qiydi (.gitattributes ham)
[*.{bat,cmd}]
end_of_line = crlf
